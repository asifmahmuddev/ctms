# Copy this file to .env and fill in the values. Never commit .env.
#
# Generate a secret key with:
#   python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"

# --- Django ------------------------------------------------------------------------------------
DJANGO_SECRET_KEY=
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DJANGO_LOG_LEVEL=INFO

# --- MongoDB -----------------------------------------------------------------------------------
# Connection string format:
#   mongodb+srv://<user>:<password>@<cluster>.mongodb.net/?retryWrites=true&w=majority
# URL-encode any of @ : / ? # [ ] % that appear in the password.
MONGODB_URI=
MONGODB_NAME=ctmsdb

# --- Email -------------------------------------------------------------------------------------
# Any SMTP provider serves. Leave EMAIL_HOST_USER empty to print messages to the console instead,
# and where a provider issues app passwords, use one rather than the account's own.
EMAIL_HOST=localhost
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
