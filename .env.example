# Copy this file to .env and fill in the values. Never commit .env.
#
# Generate a secret key with:
#   python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"

# --- Django ------------------------------------------------------------------------------------
DJANGO_SECRET_KEY=
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DJANGO_LOG_LEVEL=INFO

# --- MongoDB -----------------------------------------------------------------------------------
# Connection string format:
#   mongodb+srv://<user>:<password>@<cluster>.mongodb.net/?retryWrites=true&w=majority
# URL-encode any of @ : / ? # [ ] % that appear in the password.
MONGODB_URI=
MONGODB_NAME=ctmsdb

# --- Email -------------------------------------------------------------------------------------
# Any SMTP provider serves. Leave EMAIL_HOST_USER empty to print messages to the console instead,
# and where a provider issues app passwords, use one rather than the account's own.
EMAIL_HOST=localhost
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=

# --- Social sign-in ----------------------------------------------------------------------------
# A free OAuth client of type "Web application". Register <site address>/accounts/google/login/
# callback/ as a redirect URI for every address the site answers on; blank withholds the button.
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=

# --- reCAPTCHA ---------------------------------------------------------------------------------
# A free v3 key pair, registered for every domain the site answers on. A blank secret accepts
# every submission without asking the service.
RECAPTCHA_SITE_KEY=
RECAPTCHA_SECRET_KEY=

# --- Routing -----------------------------------------------------------------------------------
# A free key from https://openrouteservice.org. It stays on the server: the browser reaches
# geocoding and routing through this project, never the service directly.
OPENROUTESERVICE_API_KEY=

# --- Production --------------------------------------------------------------------------------
# Origins that may submit a form, scheme included, comma-separated. Only needed cross-origin.
DJANGO_CSRF_TRUSTED_ORIGINS=

# Seconds a browser refuses plain HTTP here. Raise once HTTPS is stable; it cannot be withdrawn.
DJANGO_HSTS_SECONDS=3600
